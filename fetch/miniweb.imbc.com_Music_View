              $(".btn-more").on('click', function(e){
                                      e.preventDefault;
                                      var show = $(this).parent().hasClass('on');
                $(this).toggleClass("on");
                                      if (show == true) {
                    $(this).parent().removeClass('on');
                    $(this).text('내용 더보기').append('<span class="icon ico-arrowB"></span>')
                                          $(".view-con").css({'height':256});
                      } else {
                    $(this).parent().addClass('on');
                    $(this).text('내용 닫기').append('<span class="icon ico-arrowB"></span>')
                    $(".view-con").css({'height':'auto'});
                }
              })
            } else {
                $(".view-con").height(0);
              return false;
            }
          });
