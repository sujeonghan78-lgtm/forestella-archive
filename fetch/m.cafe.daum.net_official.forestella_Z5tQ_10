									sessionStorage.setItem('fancafeInfo', JSON.stringify(cafe.fancafe.fancafeInfo));
									sessionStorage.setItem('fancafeWidgetConfig', JSON.stringify(result));
								}
								cafe.fancafe.widget.init(config);
							}, function () {
								var fandomRank = document.getElementById('rank-number').parentNode;
								fandomRank.parentNode.removeChild(fandomRank);
							});
						});

						jQuery(function () {
							cafe.fancafe.apiCaller.generateFancafeInfo({grpid: grpid});
						});

						var fancafeInfo = sessionStorage.getItem("fancafeInfo");
						var fancafeWidgetConfig = sessionStorage.getItem("fancafeWidgetConfig");

						var parsedFancafeInfo = JSON.parse(fancafeInfo);

						if (parsedFancafeInfo != null && fancafeWidgetConfig != null && location.pathname.slice(1).startsWith(parsedFancafeInfo.cafe.grpcode)) {
							cafe.fancafe.fancafeInfo = parsedFancafeInfo;
