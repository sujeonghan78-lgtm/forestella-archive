						var calendar = jQuery('.visual_link_calendar');
						calendar.find('.txt_month').html(months[today.getMonth()]);
						calendar.find('.txt_day').html(today.getDate());

						var url = location.pathname.split('/');
						var NOT_FOUND = 404;

						jQuery.ajax({
							method: 'GET',
