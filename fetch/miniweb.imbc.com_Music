<form action="/Music/Search" method="post" name="searchform" onsubmit="return valdationSearch()"><input id="progCode" name="progCode" type="hidden" value="RAMFM300" />        <div class="search-area color-bg2">
            
            <div class="search-wrap">
                <label for="sortSearch" class="tit">분류별 검색</label>
                <select name="searchType" id="sortSearch">
                    <option value="">선택</option>
                    <option value="1">제목</option>
                    <option value="2">가수</option>
                    <option value="3">곡명</option>
                </select>
                <div class="search-box">
                    <input type="text" id="miniSearch" name="searchWord">
                    <label for="miniSearch" class="color-bg"><button type="submit">검색</button><span class="icon ico-search"></span></label>
                </div>
            </div>
        </div>
</form></div>


        
    <script type="text/javascript">
        window.onload = function () {
            var height = document.body.offsetHeight;
            var sendScripts = "";

            sendScripts += "if (document.getElementById('songlist_frame') != null) { document.getElementById('songlist_frame').style.height = '" + height + "px'; }";

            var postObj = {
                action_type: "Eval",
                action: sendScripts,
                height: height
            };

            if (window.parent) {
                window.parent.postMessage(JSON.stringify(postObj), "*");
            }

        }

        function valdationSearch() {
            if ($("#sortSearch option:selected").val() == "") {
                alert('검색할 분류를 선택해 주세요.');
                return false;
            }
            if ($("#miniSearch").val() == "") {
                alert('검색어를 입력해 주세요.');
                return false;
            }
            return true;
        }

    </script>


